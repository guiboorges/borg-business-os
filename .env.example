# Supabase — project dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEVER expose on the client — only used in scripts and server-side route handlers
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Path to the Obsidian vault (only used by the local sync scripts)
VAULT_PATH="/path/to/your/vault"

# Folder with the prospecting Excel files (only used by npm run import:leads)
LEADS_DIR="/path/to/the/excel/folder"
# Database password (only for scripts/apply-migrations.ts)
SUPABASE_DB_PASSWORD=
