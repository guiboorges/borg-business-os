# Supabase — painel do projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA expor no cliente — só usada em scripts e route handlers server-side
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Caminho do vault Obsidian (só usado pelos scripts locais de sync)
VAULT_PATH="/caminho/para/o/seu/vault"

# Pasta com os Excel de prospecção (só usado por npm run import:leads)
LEADS_DIR="/caminho/para/a/pasta/dos/excel"
# Password da base de dados (só para scripts/apply-migrations.ts)
SUPABASE_DB_PASSWORD=
